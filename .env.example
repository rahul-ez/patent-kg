# Copy this file to patent-kg/.env and replace every placeholder locally.
# `.env` is ignored by Git and must never be committed.

# Optional: required only by code paths that query PatentsView.
PATENTSVIEW_API_KEY=your_patentsview_api_key

# Required for Gemini-backed evaluation features; leave blank to use fallbacks.
GOOGLE_API_KEY=your_google_gemini_api_key

# Required for Neo4j knowledge-graph operations.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Required only by the Neo4j dump/load utility scripts.
NEO4J_HOME=C:\\path\\to\\your\\neo4j-dbms

# MySQL source-of-truth database.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=patent_intelligence
MYSQL_USER=patent_app
MYSQL_PASSWORD=your_mysql_app_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# Authentication: false is for loopback HTTP development only.
# Set true behind HTTPS in deployment; cookies contain an opaque session, not a JWT.
SESSION_COOKIE_SECURE=false
SESSION_HOURS=12
# Exact browser origins, without trailing slashes. Never use a wildcard.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Public patent embeddings only. Disable disk caching for memory-only operation.
PATENT_EMBEDDING_DISK_CACHE=true
# Bump when changing encoder weights/revision or text preprocessing; restart API.
PATENT_EMBEDDING_REVISION=1
